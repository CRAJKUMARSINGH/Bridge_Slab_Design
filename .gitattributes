*.DXF filter=lfs diff=lfs merge=lfs -text
*.DWG filter=lfs diff=lfs merge=lfs -text
*.XLS filter=lfs diff=lfs merge=lfs -text
*.XLSX filter=lfs diff=lfs merge=lfs -text
*.XLSM filter=lfs diff=lfs merge=lfs -text
*.DOC filter=lfs diff=lfs merge=lfs -text
# The permanent research corpus is LFS-backed regardless of extension. The tree
# carries formats that have no dedicated rule above (.fil, .ast, .gen, .rtf,
# .txt and their uppercase spellings), so a path rule is used instead of one
# line per extension: a new format arriving in the corpus then cannot silently
# commit its bytes inline. Placed last so it wins for this path; the values
# match the extension rules, so the overlap is a no-op.
reference-design-examples/** filter=lfs diff=lfs merge=lfs -text
