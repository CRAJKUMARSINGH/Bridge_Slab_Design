{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge-slab-design.local/schemas/project-input.schema.json",
  "title": "ProjectInput",
  "description": "Canonical bridge project inputs for bridge-excel-generator and POST /api/design/calculate. Omitted keys are merged from server defaults (server/default-project-inputs.ts). GET /api/design/schema returns this document. W12+ optional keys: issuingAuthority, jobNumber, hardRockAvailable, concreteGrade* overrides for TechNote/Tech Report.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "projectName": { "type": "string", "description": "Project / bridge name" },
    "location": { "type": "string", "description": "Site location" },
    "riverName": { "type": "string", "description": "River or nala name" },
    "bridgeType": { "type": "string", "enum": ["submersible", "high-level"], "description": "Bridge class: submersible (legacy default) or high-level slab" },
    "skew": { "type": "number", "description": "Skew angle in degrees (0 = square)" },
    "spanLength": { "type": "number", "description": "Span length (m)" },
    "numberOfSpans": { "type": "number", "description": "Number of spans (count)" },
    "carriageWidth": { "type": "number", "description": "Carriageway width (m)" },
    "numberOfLanes": { "type": "number", "description": "Number of traffic lanes (IRC live load)", "minimum": 1 },
    "totalLength": { "type": "number", "description": "Total bridge length (m)" },
    "hfl": { "type": "number", "description": "Highest flood level (m MSL)" },
    "bedLevel": { "type": "number", "description": "Average bed level (m MSL)" },
    "foundationLevel": { "type": "number", "description": "Foundation level (m MSL)" },
    "discharge": { "type": "number", "description": "Design discharge (m³/s)" },
    "manningN": { "type": "number", "description": "Manning n (rugosity)" },
    "bedSlope": { "type": "number", "description": "Bed slope as 1 in X (denominator X)" },
    "laceysSiltFactor": { "type": "number", "description": "Lacey's silt factor f" },
    "crossSectionData": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chainage", "gl"],
        "properties": {
          "chainage": { "type": "number", "description": "Chainage (m)" },
          "gl": { "type": "number", "description": "Ground level (m MSL)" }
        }
      }
    },
    "pierWidth": { "type": "number", "description": "Pier width across flow (m)" },
    "pierLength": { "type": "number", "description": "Pier length along bridge (m)" },
    "pierDepth": { "type": "number", "description": "Pier depth from bed (m)" },
    "numberOfPiers": { "type": "number", "description": "Number of piers (count)" },
    "pierBaseWidth": { "type": "number", "description": "Pier footing width (m)" },
    "pierBaseLength": { "type": "number", "description": "Pier footing length (m)" },
    "abutmentHeight": { "type": "number", "description": "Abutment height (m)" },
    "abutmentWidth": { "type": "number", "description": "Abutment width (m)" },
    "abutmentDepth": { "type": "number", "description": "Abutment depth (m)" },
    "dirtWallHeight": { "type": "number", "description": "Dirt wall height (m)" },
    "returnWallLength": { "type": "number", "description": "Return wall length (m)" },
    "concreteGrade": { "type": "string", "description": "e.g. M25, M30" },
    "fck": { "type": "number", "description": "Concrete fck (MPa)" },
    "steelGrade": { "type": "string", "description": "e.g. Fe415, Fe500" },
    "fy": { "type": "number", "description": "Steel yield fy (MPa)" },
    "sbc": { "type": "number", "description": "Safe bearing capacity (kPa)" },
    "phi": { "type": "number", "description": "Angle of internal friction φ (degrees)" },
    "gamma": { "type": "number", "description": "Unit weight of soil γ (kN/m³)" },
    "rtl": { "type": "number", "description": "Road top level (m MSL)" },
    "agl": { "type": "number", "description": "Average ground level (m MSL)" },
    "nbl": { "type": "number", "description": "Normal bed level (m MSL)" },
    "ofl": { "type": "number", "description": "Ordinary flood level (m MSL)" },
    "dwl": { "type": "number", "description": "Deep water level (m MSL)" },
    "deckSlabThickness": { "type": "number", "description": "Deck slab thickness (m)" },
    "freeboardAboveHfl": { "type": "number", "description": "Minimum clearance above HFL for high-level policy (m)" },
    "deckSoffitLevel": { "type": "number", "description": "Deck soffit level (m MSL); optional if derived from RTL − thickness" },
    "issuingAuthority": { "type": "string", "description": "Client / department line for TechNote & Tech Report" },
    "jobNumber": { "type": "string", "description": "Job, estimate, or file reference number" },
    "hardRockAvailable": { "type": "boolean", "description": "If true, foundation prose uses hard-rock branch" },
    "concreteGradeFoundation": { "type": "string", "description": "Optional; defaults to concreteGrade" },
    "concreteGradePier": { "type": "string", "description": "Optional; defaults to concreteGrade" },
    "concreteGradeAbutment": { "type": "string", "description": "Optional; defaults to concreteGrade" },
    "concreteGradeDeck": { "type": "string", "description": "Optional; defaults to concreteGrade" },
    "concreteGradeWearing": { "type": "string", "description": "Optional; defaults to concreteGrade" }
  }
}
