    { "glob": "python_cad/**", "tier": 2, "trust": "VERIFIED" },
    { "glob": "api/**", "tier": 2, "trust": "VERIFIED" },
    { "glob": "pipeline/**", "tier": 2, "trust": "VERIFIED" },
