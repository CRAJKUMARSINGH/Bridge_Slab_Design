{
  "version": "1.0.0",
  "note": "Blast-radius map. Order matters: first matching glob wins. Directories in IGNORED_DIRS of gate-tiers are exempt (vendor / foreign / scratch trees).",
  "ignored": [
    "node_modules",
    "dist",
    ".git",
    ".trae",
    ".local",
    ".pnpm-store-local",
    "tmp",
    "_tmp_",
    "merge-refs",
    "VENICE-REFERENCES",
    "Attached_Assets",
    "assets"
  ],
  "artifacts": [
    { "glob": "corpus/raw/**", "tier": 0, "trust": "EXTERNAL" },
    { "glob": "corpus/oracle/GOLDEN-ORACLE.json", "tier": 1, "trust": "VERIFIED", "derivedFrom": ["corpus/raw/**"] },
    { "glob": "containment/**", "tier": 1, "trust": "VERIFIED" },
    { "glob": "foundation/**", "tier": 1, "trust": "VERIFIED" },
    { "glob": "CANONICAL.md", "tier": 1, "trust": "VERIFIED" },
    { "glob": "inputs/**", "tier": 1, "trust": "VERIFIED" },
    { "glob": "lib/engine/src/contracts.ts", "tier": 1, "trust": "VERIFIED", "derivedFrom": [] },
    { "glob": "docs/phase-2/containment/**", "tier": 1, "trust": "VERIFIED" },
    { "glob": "docs/phase-2/specs/**", "tier": 1, "trust": "VERIFIED" },
    { "glob": "docs/phase-2/govt/**", "tier": 1, "trust": "VERIFIED" },
    { "glob": "docs/phase-2/verification/**", "tier": 1, "trust": "VERIFIED" },
    { "glob": "docs/phase-2/week-*/**", "tier": 1, "trust": "VERIFIED" },
    { "glob": "docs/adr/**", "tier": 4, "trust": "ASSERTED", "assertedBy": "various" },
    { "glob": "lib/**", "tier": 2, "trust": "VERIFIED", "derivedFrom": ["lib/engine/src/contracts.ts"] },
    { "glob": "server/**", "tier": 2, "trust": "VERIFIED" },
    { "glob": "client/**", "tier": 2, "trust": "VERIFIED" },
