# ─────────────────────────────────────────────────────────────────────────────
# Bridge Design Suite — Environment Variables
# Copy this file to .env for local development.
# Set these in your Netlify / Vercel dashboard for production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get this from https://console.neon.tech → your project → Connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API.
# For Netlify: https://your-site.netlify.app
# For Vercel:  https://your-project.vercel.app
ALLOWED_ORIGINS=https://your-site.netlify.app,https://your-project.vercel.app

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Base URL for the API — leave empty for same-origin (recommended).
# Only set this if your API is on a different domain.
VITE_API_BASE_URL=
