{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:client": "vite build",
    "build:vercel": "pnpm run build:client",
    "check": "pnpm run typecheck && pnpm run lint:narrative",
    "lint:narrative": "tsx scripts/lint-narrative-no-hardcoded-numbers.ts",
    "test": "pnpm --filter @workspace/scripts run test:integration",
    "audit:policy": "node scripts/check-audit-threshold.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck:flat": "tsc -p tsconfig.flat.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:tools": "tsc -p scripts/tsconfig.tools.json --noEmit",
    "typecheck": "pnpm run typecheck:libs && pnpm run typecheck:flat && pnpm run typecheck:client && pnpm run typecheck:tools && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "design": "pnpm --filter @workspace/scripts run design",
    "pipeline": "tsx pipeline/run.ts",
    "verify:golden": "pnpm --filter @workspace/scripts run verify:golden",
    "verify:sheets": "pnpm --filter @workspace/scripts run verify:sheets",
    "verify:links": "pnpm --filter @workspace/scripts run verify:links",
    "verify:values": "pnpm --filter @workspace/scripts run verify:values",
    "verify:costing": "pnpm --filter @workspace/scripts run verify:costing",
    "verify:uplift": "pnpm --filter @workspace/scripts run verify:uplift",
    "verify:cases": "pnpm --filter @workspace/scripts run verify:cases",
    "verify:outcomes": "pnpm --filter @workspace/scripts run verify:outcomes",
    "verify:parity": "pnpm --filter @workspace/scripts run verify:parity",
    "verify:presentation": "pnpm --filter @workspace/scripts run verify:presentation",
    "candidate": "tsx scripts/build-release-candidate.ts",
    "verify": "pnpm run verify:sheets && pnpm run verify:links && pnpm run verify:values && pnpm run verify:costing && pnpm run verify:uplift && pnpm run verify:cases && pnpm run verify:outcomes && pnpm run verify:parity && pnpm run verify:presentation",
    "book:56": "tsx scripts/generate-56sheet-book.ts",
    "deliverables": "pnpm --filter @workspace/scripts run deliverables",
    "assimilate": "pnpm --filter @workspace/scripts run assimilate",
    "assets:inventory": "pnpm --filter @workspace/scripts run assets:inventory",
    "assimilate:normalize": "python scripts/assimilate/normalize.py",
    "assimilate:classify": "python scripts/assimilate/classify_cells.py",
    "assimilate:classify:workbook": "python scripts/assimilate/classify_workbook.py",
    "assimilate:narrative": "python scripts/assimilate/mine_narrative.py",
    "assimilate:drawings": "python scripts/assimilate/map_drawings.py"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@tanstack/react-query": "catalog:",
    "clsx": "catalog:",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "framer-motion": "catalog:",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "catalog:",
    "nanoid": "3.3.16",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "xlsx": "^0.18.5",
    "wouter": "catalog:",
    "zod": "catalog:",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "sharp": "0.35.5",
    "word-extractor": "1.0.4",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@rollup/rollup-win32-x64-msvc": "^4.62.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-orm": "catalog:",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "catalog:",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}
